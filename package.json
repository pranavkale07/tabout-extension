{
  "name": "TabOut",
  "version": "0.3.0",
  "description": "Tab out of brackets, quotes, etc in online code editors",
  "scripts": {
    "prebuild": "node scripts/update-readme-version.js",
    "build": "node scripts/build.mjs",
    "build:firefox": "TARGET_BROWSER=firefox node scripts/build.mjs",
    "build:all": "npm run clean && npm run build && npm run build:firefox",
    "build:dev": "node scripts/build.mjs --dev",
    "build:firefox:dev": "TARGET_BROWSER=firefox node scripts/build.mjs --dev",
    "clean": "rm -rf dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "version": "node -e \"console.log(require('./package.json').version)\"",
    "zip": "cd dist/chrome && zip -r ../../releases/tabout-extension-$(npm run version --silent)-chrome.zip * -x '*.map' && cd ../firefox && zip -r ../../releases/tabout-extension-$(npm run version --silent)-firefox.zip * -x '*.map'",
    "zip:chrome": "cd dist/chrome && zip -r ../../releases/tabout-extension-$(npm run version --silent)-chrome.zip * -x '*.map'",
    "zip:firefox": "cd dist/firefox && zip -r ../../releases/tabout-extension-$(npm run version --silent)-firefox.zip * -x '*.map'"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "private": true,
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
